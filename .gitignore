# ══════════════════════════════════════════════════════════════════════════
# 絕對不進版控
# ══════════════════════════════════════════════════════════════════════════
# .env 含資料庫密碼與 API 金鑰。.env.example 才是團隊共享的規格檔。
.env
.env.local

# 未來若接入「真實客戶」文件，一律放這個目錄，並且不進版控。
# 目前 data/raw/CASE-* 全部是合成資料（假的），所以進版控 ——
# 同仁要能實際跑測試、要能挑出我們沒發現的錯誤，資料就必須跟得上程式碼。
data/raw/CLIENT-*/
data/confidential/

# ══════════════════════════════════════════════════════════════════════════
# 衍生產物：可由程式重新產生，不需版控（也避免 merge 衝突）
# ══════════════════════════════════════════════════════════════════════════
data/processed/          # data_update_finance.py 產生的清理後文字
data/.file_hashes/       # 增量更新的檔案指紋
data/benchmarks/         # scripts/fetch_benchmarks.py 可重新下載（數百 MB）
data/real/sba_7a_raw.csv # SBA 原始 CSV 過大，由 fetch_real_corpus.py 重新下載
out/                     # 評測報告、技能檔產出
llm_raw_outputs.log
_archive_v3/

# ══════════════════════════════════════════════════════════════════════════
# 環境
# ══════════════════════════════════════════════════════════════════════════
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# ══════════════════════════════════════════════════════════════════════════
# 系統
# ══════════════════════════════════════════════════════════════════════════
.DS_Store
Thumbs.db
desktop.ini

# 瀏覽器「另存新檔」產生的資源目錄（css/js/圖片），不是知識內容
*_files/

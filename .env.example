# ═══════════════════════════════════════════════════════════════════════════
# FlowMind AI — 環境設定範本
#   複製成 .env 後即可使用：  copy .env.example .env
#   .env 不進版控（含客戶資料庫密碼），.env.example 才是團隊共享的規格。
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. 本地 LLM：Ollama ────────────────────────────────────────────────────
# 全流程可離線運行。中小企業的發票、合約、銀行流水屬於營業秘密，
# 「資料不出本機」不是技術偏好，是這個場域能不能被採用的前提。
OLLAMA_BASE_URL=http://localhost:11434

# LiteLLM 相容層：不直接綁 Ollama SDK，未來要換 Claude / Azure OpenAI
# 只需改這三行，程式碼一行都不用動。
LITELLM_BASE_URL=http://localhost:11434/v1
LITELLM_API_KEY=ollama
LITELLM_PROVIDER=openai

# ── 2. 三個模型角色（依 VeriFin 實測選型，完整數據見 docs/MODEL_SELECTION.md）──
#
# 抽取模型。選 qwen3.5:9b 而不是 gemma4:e4b，是一個違反直覺但有數據支撐的決定：
#   gemma4:e4b  傳統準確率 66.7%（較高），但 48 個欄位只留白 1 次，猜錯 15 次
#   qwen3.5:9b  傳統準確率 62.5%（較低），留白 6 次，猜錯 12 次
#   → HPES 主指標：gemma +0.042 vs qwen +0.125，qwen 勝出三倍
# 也就是說，如果只看準確率會選錯模型。在授信場域，少猜一次錯的統編，
# 比多抽對一個欄位值錢。
# 附帶好處：qwen3.5:9b 是 6.6GB，在 8GB VRAM 上能完整放進顯存；
# gemma4:e4b 是 9.6GB，必定溢出到 CPU。
LLM_EXTRACT_MODEL=qwen3.5:9b
# 顧問模型刻意與抽取模型相同：避免 Ollama 在兩個模型間反覆換入換出顯存，
# 每次換模型要付 30~60 秒的載入成本，在 demo 現場是致命的。
LLM_ADVISOR_MODEL=qwen3.5:9b
# 離線合成模型：skill_builder 一次性跑，慢沒關係，要的是深度與長 context。
LLM_SYNTH_MODEL=gpt-oss:20b
# 向後相容舊腳本
LLM_MODEL=qwen3.5:9b

# ── 3. Embedding ──────────────────────────────────────────────────────────
# ollama              → 走 http://localhost:11434/api/embed（預設，不需 PyTorch）
# sentence_transformers → 本機 PyTorch 推論（需 requirements-torch.txt）
EMBED_BACKEND=ollama
EMBED_MODEL=bge-m3
EMBED_DIM=1024
# 僅 sentence_transformers 後端有效；8GB VRAM 建議設 cpu 把顯存全留給 LLM
EMBED_DEVICE=cpu

# ── 4. 向量資料庫（docker-compose.yml 啟動）───────────────────────────────
# 注意 port 是 5433 不是 5432：刻意避開系統既有 PostgreSQL，確保零衝突。
PGHOST=localhost
PGPORT=5433
PGDATABASE=flowmind
# 平時一律用 flowmind_app 連線 —— 它不是 superuser 也不是 table owner，
# 所以 Row-Level Security 對它真正生效。用 flowmind 這個管理帳號連線會繞過 RLS。
PGUSER=flowmind_app
PGPASSWORD=flowmind_app_pw
# 只有建表 / 遷移 / 稽核驗證才用管理帳號
PGADMIN_USER=flowmind
PGADMIN_PASSWORD=flowmind_dev_pw

# ── 5. 稽核 ───────────────────────────────────────────────────────────────
# 每次檢索都會寫入 audit_log，這欄位是「誰在操作」。
# 正式環境應由 SSO 帶入，開發階段用環境變數。
FLOWMIND_ACTOR=dev@flowmind.ai

# ── 6. 風險門檻（決定何時必須人工複核）────────────────────────────────────
# 信心分數低於此值 → 系統拒答並要求補件，而不是給一個看起來很像的答案
CONFIDENCE_ABSTAIN_THRESHOLD=0.45
# 涉及金額超過此門檻的建議 → 一律標記為「待授信人員覆核」
HUMAN_REVIEW_AMOUNT_TWD=5000000

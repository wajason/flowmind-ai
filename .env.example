# ═══════════════════════════════════════════════════════════════════════════
# FlowMind AI — 環境設定範本
#   複製成 .env 後即可使用：  copy .env.example .env
#   .env 不進版控（含客戶資料庫密碼），.env.example 才是團隊共享的規格。
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. 本地 LLM：Ollama ────────────────────────────────────────────────────
# 全流程可離線運行。中小企業的發票、合約、銀行流水屬於營業秘密，
# 「資料不出本機」不是技術偏好，是這個場域能不能被採用的前提。
OLLAMA_BASE_URL=http://localhost:11434

# LiteLLM 相容層：不直接綁 Ollama SDK，未來要換 Claude / Azure OpenAI
# 只需改這三行，程式碼一行都不用動。
LITELLM_BASE_URL=http://localhost:11434/v1
LITELLM_API_KEY=ollama
LITELLM_PROVIDER=openai

# ── 2. 三個模型角色（依 VeriFin 實測選型，完整數據見 docs/MODEL_SELECTION.md）──
#
# 抽取模型：gemma4:26b。
# 這是 6 模型 × 5 面向完整評測後的結論，**推翻了先前選 qwen3.5:9b 的決定**。
#
# 硬需求（不達標即淘汰，事先聲明）：
#   嚴格 JSON 失敗率 0%｜位元級輸出漂移 100%｜繁體中文純度 100%
#
#   qwen3.5:9b   繁中純度 96.11%（4 題中 26 個簡體字）→ 淘汰
#                出錯的字是「產關則務處報權標計認該帳資銀鍵險」，
#                全部是授信報告每頁都會用到的核心金融詞；
#                且 26 個全集中在最技術性的那一題，另三題掛零 ——
#                偶發失敗比穩定失敗更危險，隨手測會通過。
#   gemma4:e4b   硬需求全過，但 HPES −0.125（40 個欄位留白 0 次、猜錯 15 次）
#   llama3.2     位元一致性僅 17% → Tier 3，強制人工覆核，不可用於自動流程
#   qwen3.6:35b  各項與 gemma4:26b 相當（HPES 略高 0.05），但為中資來源，
#                且整批處理慢 5.6 倍
#   gemma4:26b   硬需求全過｜準確率 72.5%｜HPES +0.175｜留白 0 → 選用
#
# 為什麼不能只看 HPES：qwen3.5:9b 的 HPES 是正的（+0.150），
# 但它在 40 個欄位裡留白 25 次，只回答 37.5% —— 對每題都留白的模型
# HPES 恰好是 0，不難看卻毫無用處。HPES 要配「留白率」一起讀。
#
# 顯存：17GB 在 8GB VRAM 上必定大量溢出，但實測單次抽取僅 8~9 秒，
# 仍可互動使用。選型前預期它不可行 —— 這個預期被實測推翻了。
# 完整數據見 docs/MODEL_SELECTION.md 與 docs/MODEL_MATRIX.json。
LLM_EXTRACT_MODEL=gemma4:26b
# 顧問模型刻意與抽取模型相同：避免 Ollama 在兩個模型間反覆換入換出顯存，
# 每次換模型要付 30~60 秒的載入成本，在 demo 現場是致命的。
LLM_ADVISOR_MODEL=gemma4:26b
# 離線合成模型：原定 gpt-oss:20b，但本地 blob 毀損（manifest 在、檔案缺）
# 且重抓受阻於網路，暫時退回顧問模型。詳見 MODEL_SELECTION.md 第六節。
LLM_SYNTH_MODEL=gemma4:26b
# 向後相容舊腳本
LLM_MODEL=gemma4:26b
# 模型常駐時間。Ollama 預設 5 分鐘閒置就卸載，而 gemma4:26b 冷啟動
# 實測要 123.7 秒（熱啟動 9 秒）—— demo 中停下來講兩句話，
# 下一題就要當著評審的面等兩分鐘。
OLLAMA_KEEP_ALIVE=30m

# ── 3. Embedding ──────────────────────────────────────────────────────────
# ollama              → 走 http://localhost:11434/api/embed（預設，不需 PyTorch）
# sentence_transformers → 本機 PyTorch 推論（需 requirements-torch.txt）
EMBED_BACKEND=ollama
EMBED_MODEL=bge-m3
EMBED_DIM=1024
# 僅 sentence_transformers 後端有效；8GB VRAM 建議設 cpu 把顯存全留給 LLM
EMBED_DEVICE=cpu

# ── 4. 向量資料庫（docker-compose.yml 啟動）───────────────────────────────
# 注意 port 是 5433 不是 5432：刻意避開系統既有 PostgreSQL，確保零衝突。
PGHOST=localhost
PGPORT=5433
PGDATABASE=flowmind
# 平時一律用 flowmind_app 連線 —— 它不是 superuser 也不是 table owner，
# 所以 Row-Level Security 對它真正生效。用 flowmind 這個管理帳號連線會繞過 RLS。
PGUSER=flowmind_app
PGPASSWORD=flowmind_app_pw
# 只有建表 / 遷移 / 稽核驗證才用管理帳號
PGADMIN_USER=flowmind
PGADMIN_PASSWORD=flowmind_dev_pw

# ── 5. 稽核 ───────────────────────────────────────────────────────────────
# 每次檢索都會寫入 audit_log，這欄位是「誰在操作」。
# 正式環境應由 SSO 帶入，開發階段用環境變數。
FLOWMIND_ACTOR=dev@flowmind.ai

# ── 6. 風險門檻（決定何時必須人工複核）────────────────────────────────────
# 信心分數低於此值 → 系統拒答並要求補件，而不是給一個看起來很像的答案
CONFIDENCE_ABSTAIN_THRESHOLD=0.45
# 涉及金額超過此門檻的建議 → 一律標記為「待授信人員覆核」
HUMAN_REVIEW_AMOUNT_TWD=5000000
